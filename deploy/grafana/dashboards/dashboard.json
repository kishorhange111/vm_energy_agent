{
  "title": "VM Energy Agent",
  "schemaVersion": 38,
  "version": 3,
  "panels": [
    {
      "id": 1,
      "title": "VM — CPU %",
      "type": "timeseries",
      "targets": [{ "expr": "vm_cpu_usage{level=\"vm\"}" }],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "title": "VM — Memory",
      "type": "timeseries",
      "targets": [{ "expr": "vm_memory_usage_bytes{level=\"vm\"}" }],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 }
      },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 3,
      "title": "Disk IO MB/s",
      "type": "timeseries",
      "targets": [{ "expr": "vm_disk_io_mb_per_sec{level=\"vm\"}" }],
      "fieldConfig": {
        "defaults": { "unit": "MBs", "min": 0 }
      },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 4,
      "title": "Network MB/s",
      "type": "timeseries",
      "targets": [
        { "expr": "vm_network_recv_mb_per_sec{level=\"vm\"}", "legendFormat": "recv" },
        { "expr": "vm_network_sent_mb_per_sec{level=\"vm\"}", "legendFormat": "sent" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "MBs", "min": 0 }
      },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 5,
      "title": "Estimated Power (watts)",
      "type": "timeseries",
      "targets": [{ "expr": "vm_power_watts{level=\"vm\"}" }],
      "fieldConfig": {
        "defaults": { "unit": "watt", "min": 0, "max": 250 }
      },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 }
    },
    {
      "id": 6,
      "title": "Process — CPU %",
      "type": "timeseries",
      "targets": [{ "expr": "vm_cpu_usage{level=\"process\"}" }],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0 }
      },
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 }
    },
    {
      "id": 7,
      "title": "Thread — CPU %",
      "type": "timeseries",
      "targets": [{ "expr": "vm_cpu_usage{level=\"thread\"}" }],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0 }
      },
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 }
    },
    {
      "id": 8,
      "title": "Agent RSS Memory",
      "type": "timeseries",
      "targets": [{ "expr": "process_resident_memory_bytes" }],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "max": 104857600, "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "red",   "value": 104857600 }
          ]
        }}
      },
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 }
    },
    {
      "id": 9,
      "title": "Agent CPU rate",
      "type": "timeseries",
      "targets": [{ "expr": "rate(process_cpu_seconds_total[1m])" }],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 0.02, "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "red",   "value": 0.02 }
          ]
        }}
      },
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 }
    }
  ]
}