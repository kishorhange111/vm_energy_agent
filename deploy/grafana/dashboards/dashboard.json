{
  "title": "VM Energy Agent",
  "schemaVersion": 38,
  "version": 2,
  "panels": [
    {
      "id": 1,
      "title": "VM — CPU %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "vm_cpu_usage{level=\"vm\"}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "VM — Memory %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "vm_memory_usage{level=\"vm\"}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "title": "Disk IO MB/s",
      "type": "timeseries",
      "targets": [
        {
          "expr": "vm_disk_io_mb_per_sec{level=\"vm\"}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "Network MB/s",
      "type": "timeseries",
      "targets": [
        {
          "expr": "vm_network_mb_per_sec{level=\"vm\"}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "title": "Power Score (all levels)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "vm_power_score"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      }
    },
    {
      "id": 6,
      "title": "Process — CPU %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "vm_cpu_usage{level=\"process\"}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 7,
      "title": "Thread — CPU %",
      "type": "timeseries",
      "targets": [
        {
          "expr": "vm_cpu_usage{level=\"thread\"}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "title": "Agent RSS memory (bytes)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "process_resident_memory_bytes"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 9,
      "title": "Agent CPU rate (s/s)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[1m])"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      }
    }
  ]
}