# ===========================================
# VM Energy Agent Configuration
# ===========================================

# Server port
AGENT_PORT=8080

# Instance & VM identification (used as Prometheus labels)
AGENT_INSTANCE_NAME=instance-01
AGENT_VM_NAME=vm-linux

# Power estimation coefficients (Strategy pattern)
# These weights are applied to normalized resource usage
AGENT_CPU_COEFFICIENT=0.5
AGENT_MEMORY_COEFFICIENT=0.3
AGENT_DISK_COEFFICIENT=0.1
AGENT_NETWORK_COEFFICIENT=0.1

# ===========================================
# OpenTelemetry Tracing
# ===========================================

# OTLP endpoint for trace export (used by Jaeger, Tempo, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Optional: Environment tag for traces
# AGENT_ENV=development
